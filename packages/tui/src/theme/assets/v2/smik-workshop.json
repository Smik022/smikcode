{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "olive",
      "terracotta",
      "ochre",
      "blue",
      "red"
    ],
    "skin": {
      "logo": "slab",
      "border": "square",
      "panel": "fill",
      "divider": "━",
      "header": "none",
      "turns": "space",
      "sidebar": {
        "side": "left",
        "sessions": true
      },
      "role": {
        "user": "you ▸",
        "assistant": "smik ▸"
      },
      "tool": {
        "marker": "▪",
        "status": "icon",
        "case": "none"
      },
      "prompt": {
        "prefix": "",
        "labels": "inline"
      }
    },
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "#85735a",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "#85735a",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "#85735a"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "#85735a",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.ochre.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#5b4935"
    },
    "scrollbar": {
      "base": "#6b5842"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#2f3220",
        "removed": "#3b231b",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#292b1c",
          "removed": "#331e17"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.terracotta.200",
      "function": "$hue.olive.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.300",
      "number": "$hue.ochre.200",
      "type": "$hue.blue.200",
      "operator": "$hue.terracotta.300",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.terracotta.200",
      "link": "$hue.olive.200",
      "linkText": "$hue.olive.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.terracotta.200",
      "strong": "$hue.neutral.100",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.terracotta.200",
      "listEnumeration": "$hue.olive.200",
      "image": "$hue.olive.200",
      "imageText": "$hue.olive.200",
      "codeBlock": "$hue.neutral.200"
    },
    "role": {
      "user": "$hue.terracotta.200",
      "assistant": "$hue.olive.200"
    },
    "brand": {
      "start": "$hue.terracotta.200",
      "end": "$hue.olive.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
